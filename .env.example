# Corporate Proxy Configuration (REQUIRED)
# Set these values from your corporate proxy server
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password
PROXY_HOST=proxy.company.com
PROXY_PORT=8080

# Server Configuration (Optional)
# PORT defaults to 3001 if not specified
PORT=3001

# Cloudflare Turnstile Configuration (Optional)
# Get your keys from: https://dash.cloudflare.com/
# Format: 0x... for site key, 0x... for secret key
# Leave empty for test mode
VITE_TURNSTILE_SITE_KEY=0xyour_actual_site_key_here
